# Copy to .env only if you need to override defaults. Never commit a real key.
# The Anthropic key is read from the ANTHROPIC_API_KEY environment variable (already set on this PC).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Search used by the document finder: "hybrid" (free DuckDuckGo first, Claude web search if empty),
# "anthropic" (Claude web search only, ~$0.04 per search) or "ddg" (free only)
SEARCH_BACKEND=hybrid
MAX_TOOL_CALLS=25
MAX_TOOL_CALLS_FULL=60
# Hard stop on spend per run, in US dollars (estimated from token usage)
MAX_COST_USD=1.50
